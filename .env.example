SUBMD_OCR_BASE_URL="https://云厂商地址/v1"
SUBMD_OCR_MODEL="视觉模型名称"
SUBMD_OCR_API_KEY="API Key"

# 冲突复核视觉模型：仅在文本取舍无法确定时读取来源帧。
SUBMD_OCR_REVIEW_BASE_URL=""
SUBMD_OCR_REVIEW_MODEL=""
SUBMD_OCR_REVIEW_API_KEY=""

# 字幕取舍模型：比较 YouTube 字幕与 OCR 文字。
SUBMD_TEXT_BASE_URL=""
SUBMD_TEXT_MODEL=""
SUBMD_TEXT_API_KEY=""

# 语义分句模型：只决定字符边界，不改写字幕。
SUBMD_BOUNDARY_BASE_URL=""
SUBMD_BOUNDARY_MODEL=""
SUBMD_BOUNDARY_API_KEY=""

# 语言学习模型：生成翻译、词汇、读音、搭配与文法。
SUBMD_LEARNING_BASE_URL=""
SUBMD_LEARNING_MODEL=""
SUBMD_LEARNING_API_KEY=""

# 任一模型的地址、模型名或 Key 留空时，分别采用以上五组中第一个已填写的值。
# 即使模型名称相同，五个阶段也会创建独立的配置和调用客户端。
SUBMD_YOUTUBE_URL="https://www.youtube.com/watch?v=视频ID"
SUBMD_YOUTUBE_COOKIES_FROM_BROWSER="chrome"
